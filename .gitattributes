# Normalize line endings: always store LF in git, and check out LF on every
# platform. Without this, a Windows checkout (`core.autocrlf=true`) can commit
# CRLF into files that must have LF to work on Linux/macOS: the `Makefile`, and
# any script with a `#!` line.
* text=auto eol=lf

*.ttf filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
src/cubing/vendor/mpl/twips/twips_wasm_bg-*.js filter=lfs diff=lfs merge=lfs -text
*.lfs.png filter=lfs diff=lfs merge=lfs -text
